934.00" width="300" height="18" as="geometry"/></mxCell><mxCell id="k_v" value="" style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;shape=stencil();" vertex="1" parent="1"><mxGeometry x="417.00" y="895.00" width="26" height="24" as="geometry"/></mxCell><mxCell id="tx_175" value="Small control valve with diaphragm actuator. &lt;b&gt;&lt;font color='#C00000'&gt;FC&lt;/font&gt;&lt;/b&gt; = fails closed, &lt;b&gt;&lt;font color='#007A33'&gt;FO&lt;/font&gt;&lt;/b&gt; = fails open. FCV flow, PCV pressure, LCV level, TCV temperature.&lt;br&gt;Utility lines: &lt;font color='#A93226'&gt;steam (HPS 41 bar, 254 °C; LPS 5 barg, 160 °C)&lt;/font&gt;, &lt;font color='#1F618D'&gt;cooling water 30 → 40 °C&lt;/font&gt;, &lt;font color='#117A65'&gt;boiler feed water&lt;/font&gt;.&lt;br&gt;Tags without a stream number mark unnumbered lines (design basis, to be confirmed by simulation)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;resizable=0;points=[];fontSize=9;fontColor=#000000;fillColor=none;strokeColor=none;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="450.00" y="882.00" width="420" height="90" as="geometry"/></mxCell><mxCell id="bx_176" value="&lt;b style=&quot;font-size:11px;&quot;&gt;STREAM TABLE (design basis)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9px;&quot; cellpadding=&quot;2&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Stream&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;T (°C)&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;P (bar)&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Phase&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Main components&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Remark&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;CO2 feed&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;25&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;CO2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Ambient supply (assumed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2 feed&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;25&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Ambient supply (assumed; change if your H2 is pressurised)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;MX-101 outlet&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;45&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2, CO2, CO&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Fresh gas 40 °C + recycle 45 °C; E-101 heats it to 230 °C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;R-101 effluent&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;230&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2, CO2, CH3OH, H2O, CO&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Isothermal reactor cooled by BFW; loop pressure drop neglected&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;V-101 overhead&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;45&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2, CO2, CO&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-102 cools with cooling water (45 °C is above the 40 °C limit)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Recycle (K-103 out)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;45&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2, CO2, CO&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Pressure drop neglected, so same as stream 5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;V-101 bottoms&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;45&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;50&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Liquid&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;CH3OH, H2O, dissolved gas&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Throttled by LCV-101 to the column pressure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;T-101 overhead&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;69&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;1.2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Vapor&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;CH3OH&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Boiling point of CH3OH at 1.2 bar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;T-101 bottoms&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;105&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;1.2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Liquid&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2O&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Boiling point of water at 1.2 bar&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#888888;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="995" width="860" height="195" as="geometry"/></mxCell><mxCell id="bx_177" value="&lt;b style=&quot;font-size:11px;&quot;&gt;CONTROL VALVE SCHEDULE&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9px;&quot; cellpadding=&quot;2&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Tag&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Service&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Fail&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;background:#DDE6F2;padding:2px 4px;text-align:left;&quot;&gt;Reason&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-101&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;CO2 feed (K-101 discharge)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Stop feeding reactants on air failure.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-102&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;H2 feed (K-102 discharge)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Same; both feeds close together (H2:CO2 ratio kept).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;PCV-101&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Reactor loop → V-101 (original valve)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#007A33&quot;&gt;FO&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Loop pressure control; must not over-pressure the loop.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-103&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Purge from V-101&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Keep H2/flammable gas in; PSV covers over-pressure.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;LCV-101&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;V-101 liquid → column (50 → 1.2 bar)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Throttles the liquid to column pressure; closes so 50 bar gas cannot blow into the column.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-104&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;T-101 feed&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Stop feeding the column on failure (avoid flooding).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-105&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;T-101 reflux&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#007A33&quot;&gt;FO&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Keep reflux so overhead temperature cannot rise.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;FCV-106&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Methanol product&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Keep inventory; reflux takes the whole condensate.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;LCV-102&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;T-101 bottoms water&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Keep sump level; protect P-103.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-101&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-101 HPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Loss of control must not overheat the catalyst feed.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-102&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;R-101 BFW cooling&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#007A33&quot;&gt;FO&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Exothermic reactor: maximum cooling on failure (no runaway).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-103&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-102 cooling water&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#007A33&quot;&gt;FO&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Loss of cooling must not send hot gas to V-101.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-104&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-103 LPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Stop heating on failure.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-105&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-104 cooling water&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#007A33&quot;&gt;FO&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Loss of condensation would over-pressure T-101.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;TCV-106&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;E-105 LPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;FC&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:2px 4px;vertical-align:top;&quot;&gt;Stop heating on failure.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#888888;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="1080" height="290" as="geometry"/></mxCell><mxCell id="bx_178" value="&lt;b style='font-size:11px;'&gt;WHERE EACH VALUE COMES FROM&lt;/b&gt;&lt;br&gt;&lt;b&gt;[Lecture, Ch.5]&lt;/b&gt; preferred 1-10 bar and 40-260 °C; T &amp;lt; 40 °C needs refrigeration, so use cooling water (30 → 40 °C); HPS 40-50 bar at 250-265 °C; T &amp;gt; 250 °C needs a fired heater; Pout/Pin &amp;gt; 3 → several stages with intercoolers (slide 19); a valve with large ΔP is acceptable for control or a throttled liquid (Table 6.4).&lt;br&gt;&lt;b&gt;[Literature, from search summaries; full papers not readable here]&lt;/b&gt; (a) Cu/ZnO/Al2O3 tested at 200-230 °C and 50-80 bar (UCM, link 1). (b) Make-up gas heated to 230 °C before an isothermal plug-flow reactor (Nyári et al., link 2). (c) Patent: 150-300 °C, preferably 200-300 °C (link 3). (d) After the reactor the mixture is cooled to 35 °C at 73.4 bar and flashed at almost reactor pressure, gas recycled (Pérez-Fortes et al. 2014, link 4); the distillation column runs near ambient pressure (Pérez-Fortes et al. 2016, link 5).&lt;br&gt;&lt;b&gt;[Chosen from the above]&lt;/b&gt; R-101 &lt;b&gt;230 °C, 50 bar&lt;/b&gt;: inside the tested window; the lowest pressure of 50-80 bar means thinner walls and less compression (special concern: high pressure, Table 6.2: 4 → 2 mol, higher pressure raises equilibrium conversion). Exothermic reaction (≈ -49.5 kJ/mol), so lower T favours conversion; the bed is cooled with BFW to stay isothermal. E-101: 45 → 230 °C with HPS at 41 bar (254 °C): approach 24 °C, LMTD ≈ 85 °C, no fired heater. V-101 &lt;b&gt;45 °C, 50 bar&lt;/b&gt;: flash at loop pressure as in (d); literature cools to 35 °C but below 40 °C the lecture requires refrigeration, so 45 °C with cooling water. T-101 &lt;b&gt;1.2 bar&lt;/b&gt;: near ambient as in (d) and above 1 bar so no vacuum (lecture).&lt;br&gt;&lt;b&gt;[Calculated]&lt;/b&gt; boiling points at 1.2 bar from CoolProp: methanol 68.8 °C (stream 8), water 104.8 °C (stream 9) - same pressure, different composition. K-101/K-102 1 → 50 bar: ratio 2.66 per stage over 4 stages; one stage would reach about 445 °C (CO2) / 657 °C (H2). Last-stage discharge about 143 °C (CO2) / 177 °C (H2) (γ = 1.29 / 1.41, isentropic efficiency 0.75).&lt;br&gt;&lt;b&gt;[Assumed - not from a source]&lt;/b&gt; feeds at 25 °C, 1 bar; last stage cooled to 40 °C; recycle at 45 °C; column feed 70 °C (below its boiling point, the boiling point of the feed was not calculated); LPS 5 barg / 160 °C; all pressure drops neglected (so K-103 only covers the loop pressure drop, and P-101 only the losses of E-103 and FCV-104). Liquid from V-101 carries dissolved CO2/H2 that flash at LCV-101: literature plants add a second, low-pressure flash.&lt;br&gt;&lt;b&gt;Links:&lt;/b&gt; (1) docta.ucm.es/entities/publication/f691fa62-7d12-409a-8a55-90cff01bbd32 (2) researchgate.net/publication/341739508 (3) US 9,133,074, image-ppubs.uspto.gov/dirsearch-public/print/downloadPdf/9133074 (4) researchgate.net/publication/272381030 (5) ideas.repec.org/a/eee/appene/v161y2016icp718-732.html. &lt;font color='#C00000'&gt;&lt;b&gt;Confirm all values with a simulation before using them for design.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fillColor=#FFFBE6;strokeColor=#888888;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="1205" width="1960" height="185" as="geometry"/></mxCell><mxCell id="ed_16" style="html=1;rounded=0;endArrow=none;endFill=1;endSize=5;strokeWidth=1;strokeColor=#000000;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="src_co2" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed_17" style="html=1;rounded=0;endArrow=classic;endFill=1;endSize=5;strokeWidth=1;strokeColor=#000000;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s1" target="k101"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed_18" style="html=1;rounded=0;endArrow=none;endFill=1;endSize=5;strokeWidth=1;strokeColor=#000000;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7500;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="k101" target="fcv101"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="233" y="335.5"/></Array></mxGeometry></mxCell><mxCell id="ed_19" style="html=1;rounded=0;endArrow=none;endFill=1;endSize=5;strokeWidth=1;strokeColor=#000000;exitX=0.7500;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="fcv101" target="jf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed_20" style="html=1;rounded=0;endArrow=none;endFill=1;endSize=5;strokeWidth=1;strokeColor=#000000;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" pare